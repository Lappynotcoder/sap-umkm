    <style>
        :root {
            --sap-primary: #1a6b3a;
            --sap-accent:  #f4a100;
            --sap-light:   #f8fdf9;
        }
        body { background: var(--sap-light); font-family: 'Segoe UI', sans-serif; }

        /* ── Navbar ── */
        .navbar-sap { background: var(--sap-primary); }
        .navbar-sap .navbar-brand { font-weight: 700; color: #fff !important; letter-spacing: 1px; }
        .navbar-sap .nav-link { color: rgba(255,255,255,.85) !important; }
        .navbar-sap .nav-link:hover,
        .navbar-sap .nav-link.active { color: var(--sap-accent) !important; }

        /* ── Cards ── */
        .card-metric {
            border: none; border-radius: 12px;
            box-shadow: 0 2px 12px rgba(0,0,0,.08);
            transition: transform .2s;
        }
        .card-metric:hover { transform: translateY(-3px); }
        .metric-icon { font-size: 2rem; }

        /* ── Footer ── */
        footer { background: var(--sap-primary); color: rgba(255,255,255,.7); }

        /* ── Badge Profit ── */
        .badge-profit-pos { background: #d4edda; color: #155724; }
        .badge-profit-neg { background: #f8d7da; color: #721c24; }

        /* ── SDGs badge ── */
        .sdg-badge { border-radius: 8px; font-weight: 600; font-size: .75rem; padding: .3rem .6rem; }
        .sdg-8  { background: #a21942; color: #fff; }
        .sdg-9  { background: #fd6925; color: #fff; }
    </style>
    @stack('styles')
</head>
